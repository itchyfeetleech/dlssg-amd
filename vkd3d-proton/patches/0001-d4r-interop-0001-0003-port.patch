+HRESULT d3d12_command_list_retain_external_resources(struct d3d12_command_list *list, IUnknown *resources)
+{
+    struct d3d12_command_allocator *allocator = list->allocator;
+    size_t i;
+
+    if (!list->is_recording || !allocator)
+        return E_INVALIDARG;
+    for (i = 0; i < allocator->external_resources_count; i++)
+        if (allocator->external_resources[i] == resources)
+            return S_OK;
+    if (!vkd3d_array_reserve((void **)&allocator->external_resources, &allocator->external_resources_size,
+            allocator->external_resources_count + 1, sizeof(*allocator->external_resources)))
+        return E_OUTOFMEMORY;
+    IUnknown_AddRef(resources);
+    allocator->external_resources[allocator->external_resources_count++] = resources;
+    return S_OK;
+}
