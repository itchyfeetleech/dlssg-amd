+static HRESULT STDMETHODCALLTYPE d3d12_dxvk_interop_device_GetVulkanLinearImageInfo(d3d12_dxvk_interop_device_iface *iface,
+        ID3D12Resource *resource, UINT64 *vk_memory, UINT64 *memory_size, UINT64 *offset, UINT64 *row_pitch)
+{
+    struct d3d12_device *device = d3d12_device_from_ID3D12DXVKInteropDevice(iface);
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct d3d12_resource *resource_impl;
+    VkImageSubresource subresource;
+    VkSubresourceLayout layout;
+
+    if (!resource || !vk_memory || !memory_size || !offset || !row_pitch)
+        return E_INVALIDARG;
+
+    resource_impl = impl_from_ID3D12Resource(resource);
+    if (!(resource_impl->flags & VKD3D_RESOURCE_D4R_LINEAR) ||
+            resource_impl->mem.device_allocation.vk_memory == VK_NULL_HANDLE)
+        return E_FAIL;
+
+    subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    subresource.mipLevel = 0;
+    subresource.arrayLayer = 0;
+    VK_CALL(vkGetImageSubresourceLayout(device->vk_device, resource_impl->res.vk_image, &subresource, &layout));
+
+    *vk_memory = (UINT64)resource_impl->mem.device_allocation.vk_memory;
+    *memory_size = (UINT64)resource_impl->mem.device_allocation.size;
+    *offset = (UINT64)resource_impl->mem.offset + layout.offset;
+    *row_pitch = (UINT64)layout.rowPitch;
+    return S_OK;
+}
