+HRESULT d3d12_command_list_split_for_external_wait(struct d3d12_command_list *list,
+        VkSemaphore semaphore, uint64_t value)
+{
+    struct d3d12_command_list_iteration *iteration;
+    unsigned int count;
+
+    if (!list->is_recording)
+        return E_INVALIDARG;
+    if (!d3d12_command_list_allows_new_sequence(list))
+    {
+        WARN("Cannot split command list for external wait with a running query.\n");
+        return E_FAIL;
+    }
+
+    /* Flush everything recorded so far into the current command buffer. */
+    d3d12_command_list_decay_tracked_state(list);
+    d3d12_command_list_invalidate_all_state(list);
+
+    count = list->cmd.iteration_count;
+    d3d12_command_list_begin_new_sequence(list, false);
+    if (list->cmd.iteration_count == count)
+    {
+        WARN("Out of command list sequences for external wait.\n");
+        return E_FAIL;
+    }
+
+    iteration = &list->cmd.iterations[list->cmd.iteration_count - 1];
+    iteration->external_wait_semaphore = semaphore;
+    iteration->external_wait_value = value;
+    return S_OK;
+}
